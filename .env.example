# Environment variables for Scoutica
# Copy to .env.local and fill in values. Production vars go into Vercel dashboard.

# ─── Database ───
DATABASE_URL="postgresql://user:password@localhost:5432/scoutica?schema=public"

# ─── Auth.js / NextAuth ───
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — enables "Continue with Google" button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Stripe ───
# Required to run any checkout / webhook locally
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price IDs (create products + recurring prices in Stripe dashboard)
#   Scout Pro:        €29 / month  → STRIPE_SCOUT_PRO_PRICE_ID
#   Scout Pro Annual: €290 / year  → STRIPE_SCOUT_PRO_ANNUAL_PRICE_ID
#   Agency:           €99 / month  → STRIPE_AGENCY_PRICE_ID   (founding price; raise to €149 later)
#   Agency Annual:    €990 / year  → STRIPE_AGENCY_ANNUAL_PRICE_ID
#   Studio Pro:       €49 / month  → STRIPE_STUDIO_PRICE_ID
#   Studio Pro Ann.:  €490 / year  → STRIPE_STUDIO_ANNUAL_PRICE_ID
#   Profile Boost:    €4.99 / one-shot → STRIPE_BOOST_PRICE_ID
STRIPE_SCOUT_PRO_PRICE_ID=""
STRIPE_SCOUT_PRO_ANNUAL_PRICE_ID=""
STRIPE_AGENCY_PRICE_ID=""
STRIPE_AGENCY_ANNUAL_PRICE_ID=""
STRIPE_STUDIO_PRICE_ID=""
STRIPE_STUDIO_ANNUAL_PRICE_ID=""
STRIPE_BOOST_PRICE_ID=""

# ─── Cloudflare R2 (Object storage for uploaded images) ───
# When unset → falls back to local public/uploads/ (effimero on Vercel).
# In Cloudflare: R2 → Manage R2 API Tokens → Create API token (Read & Write).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# NOTE: the code reads R2_BUCKET_NAME (src/lib/storage.ts) — not R2_BUCKET.
R2_BUCKET_NAME="scoutica-media"
R2_PUBLIC_URL="https://media.scoutica.it"

# ─── Resend (Transactional email) ───
RESEND_API_KEY=""
EMAIL_FROM="Scoutica <noreply@scoutica.it>"

# ─── Upstash Redis (Distributed rate limiting) ───
# When unset → in-memory fallback (per-instance only; not safe on serverless).
# In Upstash: Console → Create Database → Global → REST API tab.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Cloudflare Turnstile (Bot protection on register/login) ───
# When unset → no captcha rendered, server check skipped.
# In Cloudflare: Turnstile → Add site → Invisible mode recommended.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Vercel Cron (Scheduled jobs auth) ───
# Required in production — Vercel auto-injects as Bearer header.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# ─── Mapbox (Studio map view) ───
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Scoutica"
